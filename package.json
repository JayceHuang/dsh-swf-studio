{
  "name": "dsh-swf-studio",
  "version": "0.3.0",
  "description": "大澳渔庄灯光工作台：60 个主题的 FloorLED 完整地砖屏素材制作与本地 SWF 导出。",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "files": [
    "src",
    "lib",
    "scripts",
    "tests",
    "cordis.patch.yml",
    "README.md",
    "WINDOWS.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "license": "MIT"
}
